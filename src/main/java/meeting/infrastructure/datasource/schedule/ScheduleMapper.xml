<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="meeting.infrastructure.datasource.schedule.ScheduleMapper">
    <select id="newScheduleNumber" resultType="int">
        SELECT NEXTVAL('日程候補.日程番号')
    </select>

    <insert id="insertSchedule">
        INSERT INTO 日程候補._日程(
            日程番号,
            ミーティング番号,
            開催日,
            開始時間,
            開始分,
            会議時間
        ) VALUES (
            #{scheduleNumber.value},
            #{meetingNumber.value},
            #{meetingDate.value},
            #{startHour.value},
            #{startMinuteValue},
            #{durationValue})
    </insert>

    <resultMap id="schedulesByMeetingNumberMap" type="meeting.domain.model.schedule.Schedule">
        <id property="scheduleNumber.value" column="日程番号" javaType="int"/>
        <association property="scheduleConstruct" javaType="meeting.domain.model.schedule.construct.ScheduleConstruct">
            <result property="meetingDate.value" column="開催日" javaType="java.time.LocalDate"/>
            <result property="startHour.value" column="開始時間" javaType="int"/>
            <result property="startMinute" column="開始分"
                         javaType="meeting.domain.model.schedule.construct.StartMinute"
                         typeHandler="meeting.infrastructure.datasource.schedule.construct.StartMinuteTypeHandler"/>
            <result property="duration" column="会議時間"
                         javaType="meeting.domain.model.schedule.construct.Duration"
                         typeHandler="meeting.infrastructure.datasource.schedule.construct.DurationTypeHandler"/>
        </association>
    </resultMap>

    <select id="selectSchedulesByMeetingNumber" resultMap="schedulesByMeetingNumberMap">
        SELECT
            日程番号,
            開催日,
            開始時間,
            開始分,
            会議時間
        FROM
            日程候補._日程
        WHERE
            ミーティング番号 = #{meetingNumber.value}
        ORDER BY
            開催日 ASC,
            開始時間 ASC,
            開始分 ASC,
            会議時間 ASC
    </select>

    <delete id="deleteSchedulesByMeetingNumber">
        DELETE FROM 日程候補._日程
        WHERE ミーティング番号 = #{meetingNumber.value}
    </delete>
</mapper>
