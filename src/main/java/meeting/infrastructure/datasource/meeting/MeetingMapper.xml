<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="meeting.infrastructure.datasource.meeting.MeetingMapper">
    <select id="newMeetingId" resultType="meeting.domain.model.meeting.MeetingId">
        SELECT REPLACE(CAST(GEN_RANDOM_UUID() AS VARCHAR), '-', '');
    </select>

    <insert id="insertMeeting">
        INSERT INTO ミーティング.ミーティング(ミーティングID, 件名)
        VALUES (#{meetingId.value}, #{subject.value})
    </insert>

    <insert id="insertMeetingMemo">
        INSERT INTO ミーティング.ミーティングメモ(ミーティングID, メモ)
        VALUES (#{meetingId.value}, #{memo.value})
    </insert>

    <insert id="insertOrganizerTerminal">
        INSERT INTO ミーティング.主催者端末(ミーティングID, IPアドレス, OSファミリー, ユーザーエージェントファミリー)
        VALUES (#{meetingId.value}, #{ipAddress.value}, #{osFamily.value}, #{userAgentFamily.value})
    </insert>

    <resultMap id="meeting" type="meeting.domain.model.meeting.Meeting">
        <association property="schedules.list"
                     column="meetingId.value"
                     select="meeting.infrastructure.datasource.schedule.ScheduleMapper.selectByMeetingId" />
        <association property="organizerTerminal"
                     column="meetingId.value"
                     select="meeting.infrastructure.datasource.meeting.MeetingMapper.selectOrganizerTerminal"/>
    </resultMap>

    <select id="selectOrganizerTerminal" resultType="meeting.domain.model.meeting.organizer.OrganizerTerminal">
        SELECT
            IPアドレス as "ipAddress.value",
            OSファミリー as "osFamily.value",
            ユーザーエージェントファミリー as "userAgentFamily.value"
        FROM
            ミーティング.主催者端末
        WHERE
            ミーティングID = #{value}
    </select>

</mapper>
